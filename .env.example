# =============================================================================
# ENVIRONMENT VARIABLES — copy to .env
# =============================================================================
# All variables are documented below. Required vars have no default and
# will cause the app to fail fast on startup if missing.
#
# Setup:  cp .env.example .env   (then fill in your values)
#
# NEVER commit .env to git.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Full Postgres connection string.
#
# Dev:  postgres://cogext:cogext@localhost:5435/cogext
#       (5435 = host port mapped in docker-compose.yml to avoid collisions)
#
# Prod: postgres://cogext:STRONG_PASS@db:5432/cogext
#       ("db" is the Docker Compose service name — internal hostname)
#       No port mapping in prod — the app talks to Postgres internally.
DATABASE_URL=postgres://cogext:cogext@localhost:5435/cogext

# Postgres credentials (used by docker-compose.prod.yml to init the database).
# Must match what's in DATABASE_URL above.
# Dev: these are set directly in docker-compose.yml (no secrets needed locally).
# Prod: set strong values here and reference them in docker-compose.prod.yml.
POSTGRES_USER=cogext
POSTGRES_PASSWORD=cogext
POSTGRES_DB=cogext


# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# Secret key for signing JWT session tokens.
# If this value changes, all existing sessions are invalidated (users must re-login).
# Generate a strong key: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-in-production

# Public self-service registration. OFF by default — this is a personal
# instance, so /register and POST /api/auth/register are closed. To add a user:
# set this to true, register the account, then set it back to false.
ALLOW_REGISTRATION=false


# -----------------------------------------------------------------------------
# AI — Embeddings (Voyage AI)
# -----------------------------------------------------------------------------
# Voyage AI generates vector embeddings for semantic search.
# Get your key: https://dash.voyageai.com/
VOYAGE_API_KEY=your-voyage-api-key-here
EMBED_MODEL=voyage-4-lite


# -----------------------------------------------------------------------------
# AI — Chat + Tagging (Anthropic Claude)
# -----------------------------------------------------------------------------
# Required. Used for chat, auto-tagging, image analysis, reflections, etc.
# Get your key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CHAT_MODEL=claude-sonnet-4-6
RECOMMENDATIONS_MODEL=claude-haiku-4-5-20251001
IMAGE_ANALYSIS_MODEL=claude-haiku-4-5-20251001
WEB_SEARCH_TOOL_VERSION=web_search_20250305


# -----------------------------------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------------------------------
# Which backend to use for uploaded images/files.
#
# "local"  — writes to public/uploads/ on disk. Next.js serves them as
#            static files. Easy for dev, but doesn't work in Docker prod
#            (the container's public/uploads/ isn't persistent).
#
# "minio"  — uploads to MinIO via the S3-compatible API. Files are persisted
#            in a Docker volume. Served via STORAGE_PUBLIC_URL.
#
# Dev default: local (no extra config needed)
# Prod:        minio (all STORAGE_* vars below become required)
STORAGE_PROVIDER=local

# MinIO / S3 settings — only needed when STORAGE_PROVIDER=minio
#
# STORAGE_ENDPOINT: the MinIO API URL (internal to Docker in prod)
#   Dev:  not needed
#   Prod: http://minio:9000
#
# STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY:
#   Must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD below.
#
# STORAGE_BUCKET:
#   The bucket name. Create it once via MinIO console at :9001.
#   Default: cogext-uploads
#
# STORAGE_PUBLIC_URL:
#   The public-facing base URL for serving files. Its PATH must match the nginx
#   location block that proxies to MinIO (see DEPLOY.md step 8). Options:
#     a) Same domain, path proxy (what DEPLOY.md uses):
#        nginx: location /uploads/ → MinIO:9000/cogext-uploads
#        → STORAGE_PUBLIC_URL=https://your-domain.com/uploads
#     b) Dedicated subdomain:
#        nginx: files.your-domain.com → MinIO:9000/cogext-uploads
#        → STORAGE_PUBLIC_URL=https://files.your-domain.com/cogext-uploads
#     c) Direct MinIO access (less ideal, exposes port)
#        → STORAGE_PUBLIC_URL=http://your-server-ip:9000/cogext-uploads
#   The stored image_path in the DB becomes: STORAGE_PUBLIC_URL/filename.jpg
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=your-minio-access-key
STORAGE_SECRET_KEY=your-minio-secret-key
STORAGE_BUCKET=cogext-uploads
STORAGE_PUBLIC_URL=https://your-domain.com/uploads


# -----------------------------------------------------------------------------
# MINIO — root credentials (used by docker-compose.prod.yml)
# -----------------------------------------------------------------------------
# These set the MinIO admin user on first boot.
# Must match STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY above.
# Generate strong values: openssl rand -hex 16
MINIO_ROOT_USER=your-minio-access-key
MINIO_ROOT_PASSWORD=your-minio-secret-key


# -----------------------------------------------------------------------------
# DEPLOY
# -----------------------------------------------------------------------------
# Server hostname — used by local scripts (download-backups.sh, download-minio-images.sh).
# Not needed in production (the server doesn't need to know its own hostname here).
DEPLOY_HOST=your-server.example.com


# -----------------------------------------------------------------------------
# OFFSITE BACKUPS (rclone) — read by scripts/backup.sh, not the app
# -----------------------------------------------------------------------------
# Optional. When enabled, backup.sh uploads each nightly backup set (the Postgres
# dump + MinIO tar) to a preconfigured rclone remote, then prunes the remote to
# the newest OFFSITE_RETAIN backups. Requires rclone installed + a configured
# remote on the server. See DEPLOY.md → "Offsite backups to Google Drive". Off
# by default — a missing/false value simply skips the upload.
OFFSITE_ENABLED=false

# rclone remote + destination folder, as "<remote>:<path>". rclone creates the
# folder on first upload (don't pre-create it under a drive.file scope). Each run
# lands in <OFFSITE_REMOTE>/<timestamp>/.
OFFSITE_REMOTE=gdrive:cogext-backups

# How many timestamped backup folders to keep offsite; older ones are purged
# after each successful upload. Must be a positive integer. Local retention is
# separate (age-based, RETENTION_DAYS inside backup.sh).
OFFSITE_RETAIN=5

# Backup notifications (healthchecks.io-style dead-man's-switch) — read by
# scripts/backup.sh, not the app. Optional. When set, backup.sh pings this URL
# on start, on success (including a "nothing changed" skip), and on failure
# (as <url>/<exit-code>). Configure the alert email + expected schedule/grace
# in the healthchecks.io UI. Unlike a self-sent email, this also alerts you when
# a backup NEVER RUNS (server down, cron broken) — the missing ping is the
# signal. Works with hosted (https://healthchecks.io) or self-hosted; just a
# URL. Empty = notifications off. See DEPLOY.md → "Backup notifications".
HEALTHCHECK_URL=


# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
# The public URL of the app. Used for generating absolute URLs.
# Dev:  http://localhost:3000
# Prod: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for protecting cron job API endpoints (Phase 5).
# Cron callers include this in the Authorization: Bearer <token> header.
# Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here
